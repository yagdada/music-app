===== ./src/app/library/page.tsx =====
"use client";

import { useEffect, useRef, useState } from "react";
import { createClient } from "@/lib/supabase/client";
import { usePlayer } from "@/components/PlayerProvider";
import TrackRow from "@/components/TrackRow";
import { useLikes } from "@/lib/useLikes";
import { TRACK_SELECT, toPlayerTrack, type FeedTrack } from "@/lib/tracks";

type Visibility = "private" | "friends";
type Tab = "uploaded" | "liked";

const MAX_SIZE = 50 * 1024 * 1024; // 50 МБ

export default function LibraryPage() {
    const supabase = createClient();
    const { playQueue, addToQueue, isQueued, current } = usePlayer();

    const [userId, setUserId] = useState<string | null>(null);
    const { likedIds, ready: likesReady, likeError, toggleLike } =
        useLikes(userId);

    const [tab, setTab] = useState<Tab>("uploaded");
    const [uploaded, setUploaded] = useState<FeedTrack[]>([]);
    const [liked, setLiked] = useState<FeedTrack[]>([]);
    const [loading, setLoading] = useState(true);
    const [uploading, setUploading] = useState(false);
    const [message, setMessage] = useState("");

    const [title, setTitle] = useState("");
    const [artist, setArtist] = useState("");
    const [visibility, setVisibility] = useState<Visibility>("private");
    const [file, setFile] = useState<File | null>(null);
    const [coverFile, setCoverFile] = useState<File | null>(null); // <-- НОВЫЙ СТЕЙТ
    const fileInputRef = useRef<HTMLInputElement>(null);

    useEffect(() => {
        async function init() {
            const {
                data: { user },
            } = await supabase.auth.getUser();

            if (!user) {
                window.location.href = "/login";
                return;
            }

            setUserId(user.id);
            await Promise.all([loadUploaded(user.id), loadLiked(user.id)]);
            setLoading(false);
        }

        void init();
    }, []);

    async function loadUploaded(uid: string) {
        const { data, error } = await supabase
            .from("tracks")
            .select(TRACK_SELECT)
            .eq("owner_id", uid)
            .order("created_at", { ascending: false });

        if (error) {
            setMessage(`Ошибка загрузки треков: ${error.message}`);
            return;
        }

        setUploaded((data ?? []) as unknown as FeedTrack[]);
    }

    async function loadLiked(uid: string) {
        const { data, error } = await supabase
            .from("track_likes")
            .select(`created_at, tracks(${TRACK_SELECT})`)
            .eq("user_id", uid)
            .order("created_at", { ascending: false });

        if (error) {
            setMessage(`Ошибка загрузки лайков: ${error.message}`);
            return;
        }

        const rows = (data ?? []) as unknown as { tracks: FeedTrack | null }[];
        setLiked(rows.map((r) => r.tracks).filter((t): t is FeedTrack => !!t));
    }

    const likedVisible = liked.filter((t) => likedIds.has(t.id));

    function onFileChange(event: React.ChangeEvent<HTMLInputElement>) {
        const selected = event.target.files?.[0] ?? null;
        setMessage("");

        if (!selected) {
            setFile(null);
            return;
        }

        if (!selected.type.startsWith("audio/")) {
            setMessage("Выбери аудиофайл (MP3, M4A, WAV, OGG).");
            setFile(null);
            return;
        }

        if (selected.size > MAX_SIZE) {
            setMessage("Файл слишком большой. Максимум — 50 МБ.");
            setFile(null);
            return;
        }

        setFile(selected);

        if (!title.trim()) {
            setTitle(selected.name.replace(/\.[^/.]+$/, ""));
        }
    }

    async function uploadTrack(event: React.FormEvent<HTMLFormElement>) {
        event.preventDefault();
        if (!file || !userId) return;

        const cleanTitle = title.trim();
        if (!cleanTitle) {
            setMessage("Введи название песни.");
            return;
        }

        setUploading(true);
        setMessage("");

        // 1. Загружаем аудиофайл
        const extension = file.name.split(".").pop()?.toLowerCase() || "mp3";
        const filePath = `${userId}/${crypto.randomUUID()}.${extension}`;

        const { error: uploadError } = await supabase.storage
            .from("tracks")
            .upload(filePath, file, { contentType: file.type });

        if (uploadError) {
            setMessage(`Не удалось загрузить файл: ${uploadError.message}`);
            setUploading(false);
            return;
        }

        // 2. Загружаем обложку (если выбрана)
        let coverUrl = null;
        if (coverFile) {
            const coverExt = coverFile.name.split(".").pop()?.toLowerCase() || "jpg";
            const coverPath = `${userId}/${crypto.randomUUID()}.${coverExt}`;

            const { error: coverError } = await supabase.storage
                .from("covers")
                .upload(coverPath, coverFile);

            if (!coverError) {
                const { data: publicUrl } = supabase.storage.from("covers").getPublicUrl(coverPath);
                coverUrl = publicUrl.publicUrl;
            }
        }

        // 3. Сохраняем в базу
        const { error: insertError } = await supabase.from("tracks").insert({
            title: cleanTitle,
            artist: artist.trim() || null,
            file_path: filePath,
            visibility,
            cover_url: coverUrl, // <-- ПЕРЕДАЕМ ССЫЛКУ НА ОБЛОЖКУ
        });

        if (insertError) {
            await supabase.storage.from("tracks").remove([filePath]);
            setMessage(`Не удалось сохранить трек: ${insertError.message}`);
            setUploading(false);
            return;
        }

        setTitle("");
        setArtist("");
        setVisibility("private");
        setFile(null);
        setCoverFile(null); // Очищаем картинку
        if (fileInputRef.current) fileInputRef.current.value = "";

        await loadUploaded(userId);
        setMessage("Песня загружена! 🎵");
        setUploading(false);
    }

    async function toggleVisibility(track: FeedTrack) {
        const next: Visibility =
            track.visibility === "private" ? "friends" : "private";

        const { error } = await supabase
            .from("tracks")
            .update({ visibility: next })
            .eq("id", track.id);

        if (error) {
            setMessage(`Не удалось изменить доступ: ${error.message}`);
            return;
        }

        setUploaded((prev) =>
            prev.map((t) => (t.id === track.id ? { ...t, visibility: next } : t))
        );
    }

    async function deleteTrack(track: FeedTrack) {
        if (!window.confirm(`Удалить «${track.title}»?`)) return;

        const { error } = await supabase
            .from("tracks")
            .delete()
            .eq("id", track.id);

        if (error) {
            setMessage(`Не удалось удалить: ${error.message}`);
            return;
        }

        await supabase.storage.from("tracks").remove([track.file_path]);
        setUploaded((prev) => prev.filter((t) => t.id !== track.id));
    }

    function playUploaded(startIndex: number) {
        playQueue(
            uploaded.map((t) => toPlayerTrack(t, userId)),
            startIndex
        );
    }

    function playLiked(startIndex: number) {
        playQueue(
            likedVisible.map((t) => toPlayerTrack(t, userId)),
            startIndex
        );
    }

    if (loading) {
        return (
            <div className="flex min-h-[50vh] items-center justify-center text-white">
                Загружаем библиотеку...
            </div>
        );
    }

    const tabClass = (active: boolean) =>
        `rounded-xl px-4 py-2 text-sm font-semibold transition ${
            active
                ? "bg-purple-600 text-white"
                : "border border-white/10 text-neutral-400 hover:bg-neutral-800"
        }`;

    return (
        <div className="mx-auto max-w-2xl text-white">
            <h1 className="text-3xl font-bold">Моя музыка</h1>
            <p className="mt-1 text-neutral-400">
                Твои загрузки и песни, которые ты лайкнул.
            </p>

            <div className="mt-6 flex gap-2">
                <button
                    onClick={() => setTab("uploaded")}
                    className={tabClass(tab === "uploaded")}
                >
                    Загружено мной ({uploaded.length})
                </button>
                <button
                    onClick={() => setTab("liked")}
                    className={tabClass(tab === "liked")}
                >
                    ♥ Понравилось ({likesReady ? likedVisible.length : "…"})
                </button>
            </div>

            {(message || likeError) && (
                <p role="status" className="mt-4 text-sm text-neutral-300">
                    {message || likeError}
                </p>
            )}

            {tab === "uploaded" && (
                <>
                    <section className="mt-6 rounded-3xl border border-white/10 bg-neutral-900 p-6">
                        <h2 className="text-lg font-bold">Загрузить песню</h2>

                        <form onSubmit={uploadTrack} className="mt-4 space-y-4">
                            <input
                                ref={fileInputRef}
                                type="file"
                                accept="audio/*"
                                onChange={onFileChange}
                                className="block w-full text-sm text-neutral-300 file:mr-4 file:rounded-xl file:border-0 file:bg-purple-600 file:px-4 file:py-2 file:font-semibold file:text-white hover:file:bg-purple-500"
                            />

                            {/* --- НОВОЕ ПОЛЕ ДЛЯ ОБЛОЖКИ --- */}
                            <div>
                                <label className="mb-2 block text-sm text-neutral-400">Обложка (картинка)</label>
                                <input
                                    type="file"
                                    accept="image/*"
                                    onChange={(e) => setCoverFile(e.target.files?.[0] || null)}
                                    className="block w-full text-sm text-neutral-300 file:mr-4 file:rounded-xl file:border-0 file:bg-neutral-800 file:px-4 file:py-2 file:font-semibold file:text-white hover:file:bg-neutral-700"
                                />
                            </div>
                            {/* ------------------------------- */}

                            <input
                                value={title}
                                onChange={(e) => setTitle(e.target.value)}
                                placeholder="Название песни"
                                maxLength={100}
                                required
                                className="w-full rounded-xl border border-white/10 bg-neutral-800 px-4 py-3 outline-none focus:border-purple-500"
                            />

                            <input
                                value={artist}
                                onChange={(e) => setArtist(e.target.value)}
                                placeholder="Исполнитель (необязательно)"
                                maxLength={100}
                                className="w-full rounded-xl border border-white/10 bg-neutral-800 px-4 py-3 outline-none focus:border-purple-500"
                            />

                            <select
                                value={visibility}
                                onChange={(e) => setVisibility(e.target.value as Visibility)}
                                className="w-full rounded-xl border border-white/10 bg-neutral-800 px-4 py-3 outline-none focus:border-purple-500"
                            >
                                <option value="private">🔒 Только я</option>
                                <option value="friends">👥 Друзья</option>
                            </select>

                            <button
                                type="submit"
                                disabled={uploading || !file}
                                className="w-full rounded-xl bg-purple-600 px-4 py-3 font-semibold hover:bg-purple-500 disabled:opacity-50"
                            >
                                {uploading ? "Загружаем..." : "Загрузить песню"}
                            </button>
                        </form>
                    </section>

                    <ul className="mt-6 space-y-3">
                        {uploaded.length === 0 && (
                            <p className="text-center text-neutral-500">
                                Пока нет песен. Загрузи первую! 🎧
                            </p>
                        )}

                        {uploaded.map((track, i) => {
                            const isCurrent = current?.id === track.id;
                            const queued = isQueued(track.id);

                            return (
                                <li
                                    key={track.id}
                                    className={`rounded-2xl border bg-neutral-900 p-4 ${
                                        isCurrent ? "border-purple-500/60" : "border-white/10"
                                    }`}
                                >
                                    <div className="flex items-center justify-between gap-3">
                                        {/* --- ДОБАВИЛИ ОБЛОЖКУ В СПИСОК --- */}
                                        <div className="flex min-w-0 items-center gap-3">
                                            <div className="h-12 w-12 shrink-0 overflow-hidden rounded-lg bg-neutral-800 flex items-center justify-center border border-white/5">
                                                {track.cover_url ? (
                                                    // eslint-disable-next-line @next/next/no-img-element
                                                    <img src={track.cover_url} alt="cover" className="h-full w-full object-cover" />
                                                ) : (
                                                    <span className="text-xl text-neutral-600">♫</span>
                                                )}
                                            </div>
                                            <div className="min-w-0">
                                                <p className="truncate font-semibold">
                                                    {isCurrent ? "🎧 " : ""}
                                                    {track.title}
                                                </p>
                                                <p className="truncate text-sm text-neutral-400">
                                                    {track.artist || "Неизвестный исполнитель"}
                                                </p>
                                            </div>
                                        </div>
                                        {/* ---------------------------------- */}

                                        <div className="flex shrink-0 gap-2">
                                            <button
                                                onClick={() => toggleLike(track.id)}
                                                aria-label={likedIds.has(track.id) ? "Убрать лайк" : "Лайкнуть"}
                                                className={`rounded-xl border border-white/10 px-4 py-2 text-lg leading-none hover:bg-neutral-800 ${
                                                    likedIds.has(track.id) ? "text-red-500" : "text-neutral-400"
                                                }`}
                                            >
                                                {likedIds.has(track.id) ? "♥" : "♡"}
                                            </button>

                                            <button
                                                onClick={() => playUploaded(i)}
                                                aria-label="Слушать"
                                                className="rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold hover:bg-purple-500"
                                            >
                                                ▶
                                            </button>
                                            <button
                                                onClick={() =>
                                                    addToQueue(toPlayerTrack(track, userId))
                                                }
                                                disabled={queued}
                                                aria-label="Добавить в очередь"
                                                className="rounded-xl border border-white/10 px-4 py-2 text-sm hover:bg-neutral-800 disabled:opacity-50"
                                            >
                                                {queued ? "✓" : "＋"}
                                            </button>
                                        </div>
                                    </div>

                                    <div className="mt-3 flex items-center justify-between text-sm">
                                        <button
                                            onClick={() => toggleVisibility(track)}
                                            className="rounded-lg border border-white/10 px-3 py-1 hover:bg-neutral-800"
                                        >
                                            {track.visibility === "private"
                                                ? "🔒 Только я"
                                                : "👥 Друзья"}
                                        </button>

                                        <button
                                            onClick={() => deleteTrack(track)}
                                            className="text-red-400 hover:text-red-300"
                                        >
                                            Удалить
                                        </button>
                                    </div>
                                </li>
                            );
                        })}
                    </ul>
                </>
            )}

            {tab === "liked" && (
                <>
                    {likedVisible.length > 0 && (
                        <div className="mt-6 flex justify-end">
                            <button
                                onClick={() => playLiked(0)}
                                className="rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold hover:bg-purple-500"
                            >
                                ▶ Играть всё
                            </button>
                        </div>
                    )}

                    {!likesReady ? (
                        <p className="mt-10 text-center text-neutral-500">Загружаем...</p>
                    ) : likedVisible.length === 0 ? (
                        <p className="mt-10 text-center text-neutral-500">
                            Пока нет лайкнутых песен. Нажми ♡ в ленте или поиске 🎧
                        </p>
                    ) : (
                        <ul className="mt-4 space-y-3">
                            {likedVisible.map((track, i) => (
                                <TrackRow
                                    key={track.id}
                                    track={track}
                                    myId={userId}
                                    onPlay={() => playLiked(i)}
                                    liked
                                    onToggleLike={() => toggleLike(track.id)}
                                />
                            ))}
                        </ul>
                    )}
                </>
            )}
        </div>
    );
}
===== ./src/app/search/page.tsx =====
"use client";

import { useEffect, useState } from "react";
import { createClient } from "@/lib/supabase/client";
import { usePlayer } from "@/components/PlayerProvider";
import TrackRow from "@/components/TrackRow";
import { TRACK_SELECT, toPlayerTrack, type FeedTrack } from "@/lib/tracks";
import { useLikes } from "@/lib/useLikes";

export default function SearchPage() {
    const supabase = createClient();
    const { playQueue } = usePlayer();

    const [userId, setUserId] = useState<string | null>(null);
    const { likedIds, toggleLike } = useLikes(userId);
    const [query, setQuery] = useState("");
    const [results, setResults] = useState<FeedTrack[]>([]);
    const [searching, setSearching] = useState(false);
    const [searched, setSearched] = useState(false);
    const [message, setMessage] = useState("");

    useEffect(() => {
        async function init() {
            const {
                data: { user },
            } = await supabase.auth.getUser();

            if (!user) {
                window.location.href = "/login";
                return;
            }

            setUserId(user.id);
        }

        void init();
    }, []);

    async function search(event: React.FormEvent<HTMLFormElement>) {
        event.preventDefault();

        const text = query.trim();
        if (text.length < 2) {
            setMessage("Введи минимум 2 символа.");
            return;
        }

        setSearching(true);
        setMessage("");

        // Убираем символы, ломающие фильтр, и экранируем шаблон поиска
        const safe = text
            .replace(/[,()"]/g, " ")
            .trim()
            .replace(/[\\%_]/g, (c) => `\\${c}`);

        const { data, error } = await supabase
            .from("tracks")
            .select(TRACK_SELECT)
            .or(`title.ilike.%${safe}%,artist.ilike.%${safe}%`)
            .order("created_at", { ascending: false })
            .limit(50);

        if (error) {
            setMessage(`Ошибка поиска: ${error.message}`);
            setResults([]);
        } else {
            setResults((data ?? []) as unknown as FeedTrack[]);
        }

        setSearched(true);
        setSearching(false);
    }

    function playFrom(startIndex: number) {
        playQueue(
            results.map((t) => toPlayerTrack(t, userId)),
            startIndex
        );
    }

    return (
        <main className="min-h-screen bg-neutral-950 px-5 py-8 text-white">
            <div className="mx-auto max-w-2xl">
                <h1 className="text-3xl font-bold">Поиск</h1>
                <p className="mt-1 text-neutral-400">
                    Ищи песни друзей по названию или исполнителю.
                </p>

                <form onSubmit={search} className="mt-6 flex gap-2">
                    <input
                        value={query}
                        onChange={(e) => setQuery(e.target.value)}
                        placeholder="Название или исполнитель"
                        maxLength={100}
                        className="min-w-0 flex-1 rounded-xl border border-white/10 bg-neutral-800 px-4 py-3 outline-none focus:border-purple-500"
                    />
                    <button
                        type="submit"
                        disabled={searching}
                        className="rounded-xl bg-purple-600 px-5 py-3 font-semibold hover:bg-purple-500 disabled:opacity-50"
                    >
                        {searching ? "..." : "Найти"}
                    </button>
                </form>

                {message && (
                    <p role="status" className="mt-4 text-sm text-neutral-300">
                        {message}
                    </p>
                )}

                {searched && results.length === 0 && !message && (
                    <p className="mt-10 text-center text-neutral-500">
                        Ничего не нашли 🔍
                    </p>
                )}

                {results.length > 0 && (
                    <ul className="mt-6 space-y-3">
                        {results.map((track, i) => (
                            <TrackRow
                                key={track.id}
                                track={track}
                                myId={userId}
                                onPlay={() => playFrom(i)}
                                liked={likedIds.has(track.id)}
                                onToggleLike={() => toggleLike(track.id)}
                            />
                        ))}
                    </ul>
                )}
            </div>
        </main>
    );
}
